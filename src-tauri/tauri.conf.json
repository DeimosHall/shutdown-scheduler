{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shutdown Scheduler",
  "version": "0.1.0",
  "identifier": "dev.deimos.shutdown-scheduler",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "shutdown-scheduler",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A utility to schedule system shutdowns and reboots",
    "longDescription": "Shutdown Scheduler is a GUI application that lets users control when they want their PCs to shutdown or reboot",
    "licenseFile": "../LICENSE",
    "license": "GPLv3",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
